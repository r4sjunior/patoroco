# Senha de entrada do sistema do admin (/admin). Use uma senha forte.
ADMIN_PASSWORD=

# Chave que assina a sessão do admin. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Postgres (Neon). Obrigatório na Vercel.
# Sem ela, em desenvolvimento, o app usa um banco embutido na pasta .data/.
DATABASE_URL=
